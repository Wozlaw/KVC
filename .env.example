# Copy this file to .env and set real local credentials manually.
# Do not commit .env or real secrets.

KVC_APP_ENV=development
KVC_LOG_LEVEL=INFO
KVC_DATABASE_URL=postgresql+asyncpg://kvc_user:change_me@127.0.0.1:5432/kvc_dev
KVC_DATABASE_ECHO=false

KVC_MAX_BOT_TOKEN=
KVC_MAX_API_BASE_URL=https://platform-api2.max.ru
KVC_MAX_WEBHOOK_SECRET=
KVC_MAX_WEBHOOK_PATH=/max/webhook
KVC_MAX_INBOUND_MODE=webhook
KVC_MAX_ALLOWED_UPDATE_TYPES=message_created,message_callback,bot_started
KVC_MAX_POLLING_TIMEOUT_SECONDS=60
KVC_MAX_POLLING_LIMIT=100
KVC_MAX_WEBHOOK_PUBLIC_URL=
KVC_MAX_MINI_APP_PUBLIC_URL=
KVC_MAX_MINI_APP_CONTEXT_SECRET=
KVC_KAITEN_API_TOKEN=
KVC_GIGACHAT_CREDENTIALS=
KVC_GIGACHAT_MODEL=GigaChat-Pro
KVC_STT_PROVIDER=
KVC_SALUTESPEECH_AUTH_KEY=

# JSON object like {"1":"<fernet-key-v1>","2":"<fernet-key-v2>"}.
# Leave blank in local environments that do not construct TokenCipher.
KVC_TOKEN_ENCRYPTION_ACTIVE_VERSION=
KVC_TOKEN_ENCRYPTION_KEYS=
